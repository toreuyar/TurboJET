{
  "description": "Synthesize stage. Verdict keys exactly match workflows/research-synthesize-verify/workflow.smg.json.",
  "type": "object",
  "required": ["verdict", "summary", "answer", "citations"],
  "properties": {
    "verdict": { "type": "string", "enum": ["drafted", "missing-evidence"] },
    "summary": { "type": "string" },
    "answer": { "type": "string", "description": "Source-backed answer; no external or invented proof." },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "excerpt"],
        "properties": {
          "path": { "type": "string", "description": "Relative path under inputs/." },
          "excerpt": { "type": "string", "description": "Exact supporting text from the cited file." }
        }
      }
    },
    "gaps": { "type": "array", "items": { "type": "string" } },
    "content": { "type": "string", "description": "Markdown answer mirrored into output.md." }
  }
}
