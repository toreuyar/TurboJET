{
  "id": "verify",
  "name": "Evidence Verifier",
  "prompt": "prompt.md",
  "schema": "schemas/verify-result.json",
  "max_output_retries": 3,
  "input": { "artifacts": [{ "name": "evidence.md", "from": "research", "required": true }, { "name": "answer.md", "from": "synthesize", "required": true }] },
  "output": { "artifacts": [{ "name": "output.md", "required": true, "verify": "non-empty" }] },
  "tools": { "read": true, "write": true, "bash": false, "edit": false },
  "timeout": 300
}
