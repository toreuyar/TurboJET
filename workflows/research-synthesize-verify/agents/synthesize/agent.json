{
  "id": "synthesize",
  "name": "Cited Synthesiser",
  "prompt": "prompt.md",
  "schema": "schemas/synthesize.json",
  "max_output_retries": 3,
  "input": { "artifacts": [{ "name": "evidence.md", "from": "research", "required": true }] },
  "output": { "artifacts": [{ "name": "output.md", "required": true, "verify": "non-empty" }] },
  "tools": { "read": true, "write": true, "bash": false, "edit": false },
  "timeout": 300
}
