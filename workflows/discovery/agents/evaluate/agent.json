{
  "id": "evaluate",
  "name": "Devil's Advocate Evaluator",
  "prompt": "prompt.md",
  "schema": "schemas/evaluate.json",
  "max_output_retries": 3,
  "input": {
    "artifacts": [
      {
        "name": "output.md",
        "from": "intake",
        "required": true
      }
    ]
  },
  "output": {
    "artifacts": [
      {
        "name": "output.md",
        "required": true,
        "verify": "non-empty"
      }
    ]
  },
  "tools": {
    "read": true,
    "write": true,
    "bash": false,
    "edit": false
  },
  "timeout": 300
}
