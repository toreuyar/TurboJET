{
  "id": "intake",
  "name": "Requirements Intake Agent",
  "prompt": "prompt.md",
  "schema": "schemas/intake.json",
  "max_output_retries": 3,
  "input": {
    "artifacts": []
  },
  "output": {
    "artifacts": [
      {
        "name": "output.md",
        "required": true,
        "verify": "non-empty"
      }
    ]
  },
  "tools": {
    "read": true,
    "write": true,
    "bash": false,
    "edit": false
  },
  "timeout": 300
}
