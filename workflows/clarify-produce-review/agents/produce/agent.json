{
  "id": "produce",
  "name": "Artifact Producer",
  "prompt": "prompt.md",
  "schema": "schemas/produce.json",
  "max_output_retries": 3,
  "input": { "artifacts": [{ "name": "clarification.md", "from": "clarify", "required": true }] },
  "output": { "artifacts": [{ "name": "output.md", "required": true, "verify": "non-empty" }] },
  "tools": { "read": true, "write": true, "bash": false, "edit": false },
  "timeout": 300
}
