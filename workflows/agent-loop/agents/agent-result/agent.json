{
  "id": "agent-result",
  "name": "Agent Loop Result",
  "prompt": "prompt.md",
  "schema": "schemas/agent-loop-result.json",
  "max_output_retries": 3,
  "input": {
    "artifacts": [
      {
        "name": "plan.md",
        "from": "agent-plan",
        "required": false
      },
      {
        "name": "draft.md",
        "from": "agent-act",
        "required": false
      },
      {
        "name": "check.md",
        "from": "agent-check",
        "required": false
      }
    ]
  },
  "output": {
    "artifacts": [
      {
        "name": "output.md",
        "required": true,
        "verify": "non-empty"
      }
    ]
  },
  "tools": {
    "read": true,
    "write": true,
    "bash": false,
    "edit": false
  },
  "timeout": 300
}
